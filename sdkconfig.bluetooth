# TARS ESP32-WROOM-32 A2DP SOURCE
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_SOURCE_ENABLE=y
CONFIG_BT_A2DP_SINK_ENABLE=n

# Tidak dipakai
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_CLASSIC_BQB_ENABLED=n
CONFIG_BT_SMP_ENABLE=n

# BR/EDR + 1 koneksi
CONFIG_BTDM_CONTROLLER_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0

# Memory
CONFIG_BT_BTC_TASK_STACK_SIZE=3072
CONFIG_BT_BTU_TASK_STACK_SIZE=3072
CONFIG_BT_BLUEDROID_PINNED_TO_CORE=n

# A2DP hanya butuh SBC Encoder
CONFIG_BT_SBC_ENC_ENABLE=y
CONFIG_BT_SBC_DEC_ENABLE=n
CONFIG_BT_SBC_ENC_PCM_NSAMPLES=64

# Codec lain OFF
CONFIG_BT_AAC_ENABLE=n
CONFIG_BT_A2DP_AAC_ENABLE=n

# L2CAP
CONFIG_BT_CLASSIC_QNUM_LINKS=1
CONFIG_BT_L2CAP_CHANNELS_NUM=4
CONFIG_BT_L2CAP_TX_BUFFER_SIZE=3
CONFIG_BT_L2CAP_DEFALT_MTU=672
