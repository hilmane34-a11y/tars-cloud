# ============================================================
# TARS ESP32 CLASSIC BLUETOOTH MEMORY PROFILE
# ESP32-WROOM-32 / A2DP SOURCE
# ============================================================

CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# TARS tidak menggunakan BLE
CONFIG_BT_BLE_ENABLED=n

# TARS tidak menggunakan SPP
CONFIG_BT_SPP_ENABLED=n

# TARS tidak menggunakan HFP
CONFIG_BT_HFP_ENABLE=n

# Tidak membutuhkan BQB qualification support
CONFIG_BT_CLASSIC_BQB_ENABLED=n

# Minimal memory tuning (added)
CONFIG_BTDM_CONTROLLER_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BT_SMP_ENABLE=n
CONFIG_BT_BLUEDROID_PINNED_TO_CORE=n
CONFIG_BT_BTC_TASK_STACK_SIZE=3072
CONFIG_BT_BTU_TASK_STACK_SIZE=3072

# Reduce SBC PCM buffer samples (lower -> less RAM, may affect quality)
CONFIG_BT_SBC_ENC_PCM_NSAMPLES=64
CONFIG_BT_SBC_DEC_PCM_NSAMPLES=64
