# ============================================================
# TARS ESP32 CLASSIC BLUETOOTH MEMORY PROFILE
# ESP32-WROOM-32 / A2DP SOURCE
# ============================================================

CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# TARS tidak menggunakan BLE
CONFIG_BT_BLE_ENABLED=n

# TARS tidak menggunakan SPP
CONFIG_BT_SPP_ENABLED=n

# TARS tidak menggunakan HFP
CONFIG_BT_HFP_ENABLE=n

# Tidak membutuhkan BQB qualification support
CONFIG_BT_CLASSIC_BQB_ENABLED=n
